# Identificador único gerado pela Expo ao vincular o projeto ao EAS
# Você pode encontrá-lo com `npx eas init` ou no painel em Project Settings → General → Project ID
EAS_PROJECT_ID=
# Slug definido para o projeto na Expo (Project Page → Settings → Project slug)
# Se o projectId já estiver no formato `@conta/slug`, ele será inferido automaticamente.
EXPO_APP_SLUG=marcacaoDeConsultasMedicas
